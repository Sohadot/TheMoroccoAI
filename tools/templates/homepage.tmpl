      <span>{{m:footer.owner_note}} · {{m:footer.disclaimer}}</span>
      <span>{{h:page.home.footer.links}}</span>
      <span>{{h:page.home.footer.languages}}</span>
    </div>
  </div>
</footer>

</body>
</html>
