    <div class="ontology-list" role="list">
      <div class="onto-item" role="listitem"><div class="onto-id">{{i:MAI-O-001}}</div><div class="onto-term">{{m:page.home.vocab.1.term}}</div><div class="onto-def">{{m:page.home.vocab.1.definition}}</div></div>
      <div class="onto-item" role="listitem"><div class="onto-id">{{i:MAI-O-002}}</div><div class="onto-term">{{m:page.home.vocab.2.term}}</div><div class="onto-def">{{m:page.home.vocab.2.definition}}</div></div>
      <div class="onto-item" role="listitem"><div class="onto-id">{{i:MAI-O-003}}</div><div class="onto-term">{{m:page.home.vocab.3.term}}</div><div class="onto-def">{{m:page.home.vocab.3.definition}}</div></div>
      <div class="onto-item" role="listitem"><div class="onto-id">{{i:MAI-O-004}}</div><div class="onto-term">{{m:page.home.vocab.4.term}}</div><div class="onto-def">{{m:page.home.vocab.4.definition}}</div></div>
      <div class="onto-item" role="listitem"><div class="onto-id">{{i:MAI-O-005}}</div><div class="onto-term">{{m:page.home.vocab.5.term}}</div><div class="onto-def">{{m:page.home.vocab.5.definition}}</div></div>
