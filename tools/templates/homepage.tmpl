        <p class="evaluate-text">{{m:page.home.evaluate.text}}</p>
      </div>
      <a class="btn-evaluate" href="{{href:/evaluation/}}">{{m:page.home.evaluate.cta}} <span class="btn-evaluate-arrow" aria-hidden="true">→</span></a>
      <p class="evaluate-note">{{m:page.home.evaluate.note}}</p>
    </div>
  </div>
</section>

<!-- 6. THE OWNER'S STRATEGIC THESIS -->
<section class="thesis-section" id="thesis">
