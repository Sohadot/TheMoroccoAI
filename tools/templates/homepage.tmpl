        <p class="thesis-cell-body">{{m:page.home.thesis.1.body}}</p>
      </div>
      <div class="thesis-cell">
        <div class="thesis-cell-id">{{h:page.home.thesis.cell.owner_view|MAI-T-002}}</div>
        <div class="thesis-cell-title">{{m:page.home.thesis.2.title}}</div>
        <p class="thesis-cell-body">{{m:page.home.thesis.2.body}}</p>
      </div>
      <div class="thesis-cell">
        <div class="thesis-cell-id">{{h:page.home.thesis.cell.ambition|MAI-T-003}}</div>
        <div class="thesis-cell-title">{{m:page.home.thesis.3.title}}</div>
        <p class="thesis-cell-body">{{m:page.home.thesis.3.body}}</p>
      </div>
      <div class="thesis-cell">
        <div class="thesis-cell-id">{{h:page.home.thesis.cell.owner_view|MAI-T-004}}</div>
        <div class="thesis-cell-title">{{m:page.home.thesis.4.title}}</div>
        <p class="thesis-cell-body">{{m:page.home.thesis.4.body}}</p>
      </div>
      <div class="thesis-cell">
