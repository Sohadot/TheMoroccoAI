      <h2>{{h:page.home.method.h2}}</h2>
    </div>

    <div class="posture-block">
      <div class="posture-label">{{h:page.home.method.rules.label}}</div>
      <p class="posture-text">
        {{m:page.home.method.rules.text}}
      </p>
      <div class="posture-rules">
        <div class="rule-item"><span class="rule-mark" aria-hidden="true">◆</span><span class="rule-text">{{m:page.home.method.rule.1}}</span></div>
        <div class="rule-item"><span class="rule-mark" aria-hidden="true">◆</span><span class="rule-text">{{m:page.home.method.rule.2}}</span></div>
        <div class="rule-item"><span class="rule-mark" aria-hidden="true">◆</span><span class="rule-text">{{m:page.home.method.rule.3}}</span></div>
        <div class="rule-item"><span class="rule-mark" aria-hidden="true">◆</span><span class="rule-text">{{h:page.home.method.rule.4}}</span></div>
        <div class="rule-item"><span class="rule-mark" aria-hidden="true">◆</span><span class="rule-text">{{m:page.home.method.rule.5}}</span></div>
        <div class="rule-item"><span class="rule-mark" aria-hidden="true">◆</span><span class="rule-text">{{m:page.home.method.rule.6}}</span></div>
